# Production build config (used by `vite build`). Vite loads .env.production AFTER .env.local, so
# these OVERRIDE local dev values — critical: it keeps any dev bearer token in .env.local OUT of
# the public production bundle.
#
# This build ships as a Facilio Vibe app that is ALSO registered as a connected app, so it runs
# embedded inside Facilio products. The vibe runtime is detected from the host at runtime (see
# lib/vibe.ts) and needs no flag; connected-app mode is pinned on here because that is how this
# build is deployed — the V3 tier is the only route to marker geometry, Moves and org forms.
#
# Opening the standalone vibe URL with this on is safe: the SDK handshake times out and the
# data tiers fall through (see facilioAppReady).
VITE_DEV_MODE=false
VITE_FACILIO_API_BASE_URL=
VITE_FACILIO_TOKEN=
VITE_IS_CONNECTED_APP=true
