# Production build config (used by `vite build`). Vite loads .env.production AFTER .env.local, so
# these OVERRIDE local dev values — critical: it keeps any dev bearer token in .env.local OUT of
# the public production bundle.
#
# This build ships as a Facilio Vibe app. It deliberately sets nothing: the app detects the vibe
# runtime from its own host, resolves its server from window.location.origin, and authenticates
# with the session cookie. A hardcoded flag here would only break a preview deploy on a different
# host.
VITE_DEV_MODE=false
VITE_FACILIO_API_BASE_URL=
VITE_FACILIO_TOKEN=
VITE_IS_CONNECTED_APP=false
