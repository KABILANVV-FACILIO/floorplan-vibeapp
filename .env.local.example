# Copy to .env.local for local development. Never commit .env.local.
#
# This is a Facilio Vibe app. Deployed, it needs NONE of these: it detects itself from its
# host (<linkName>.vibe.facilio.com), talks to its own origin, and authenticates with the
# session cookie. Everything below exists only to make `npm run dev` useful.

# ---- Default: local JSON ----
# Leave everything blank/false and the app serves src/data/*.json, persisting this session's
# edits to localStorage. No backend, no login.

# ---- Dev against the deployed vibe app's server ----
# Point the SDK at the deployed app so dev hits the real vibe DB + CMMS connector. Requires a
# browser session on that host (sign in to the app once in the same browser), since auth is
# cookie-based and cross-origin requests send credentials.
VITE_IS_VIBE_APP=false
VITE_VIBE_SERVER_URL=

# ---- Dev against a real org's V3 API via a bearer token ----
# Only needed to exercise the connected-app tier: on-plan marker geometry, desk Moves, org forms
# and file previews, none of which have a CMMS connector action. Set VITE_DEV_MODE=true and fill
# both vars. The token is sent as a Bearer header to VITE_FACILIO_API_BASE_URL (include the /api
# suffix — e.g. https://your-org.facilio.com/api) and routed through the vite dev proxy ('/fapi',
# see vite.config.ts) to dodge CORS. Tokens are short-lived; regenerate if calls start 401ing.
VITE_DEV_MODE=false
VITE_FACILIO_API_BASE_URL=
VITE_FACILIO_TOKEN=

# ---- Connected-app mode ----
# Set true only for a build served INSIDE a Facilio org as a connected app (tab/iframe) rather
# than as a vibe app. The V3 APIs are then called same-origin with session cookies.
VITE_IS_CONNECTED_APP=false
